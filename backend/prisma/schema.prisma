generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkflowStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ComponentStatus {
  FRESH
  STALE
  RUNNING
  COMPLETED
  FAILED
}

enum ArtifactStatus {
  FRESH
  STALE
}

enum DecisionType {
  ACCEPT
  REJECT
  OVERRIDE
}

enum WorkflowPhase {
  IDEA
  IDEA_DECOMPOSITION
  RESEARCH_AND_GAP
  CONTRIBUTION_AND_EXPERIMENT
  JUDGES_AND_CONFIRMATION
  FINAL_SPECIFICATION
}

enum SpecCardType {
  PROBLEM
  RESEARCH_QUESTION
  GAP_CANDIDATE
  CONTRIBUTION
  CLAIM
  EVIDENCE
  CONSTRAINT
  OPEN_QUESTION
}

enum SpecCardStatus {
  CONFIRMED
  PROPOSED
  MISSING
  AMBIGUOUS
  UNSUPPORTED
  CONFLICT
}

enum SpecCardLinkType {
  CLAIM_EVIDENCE
  DEPENDS_ON
  SUPPORTS
  CONTRADICTS
}

model ResearchProject {
  id           String              @id @default(cuid())
  title        String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  latestSpecId String?
  latestSpec   SpecIteration?      @relation("LatestSpec", fields: [latestSpecId], references: [id])
  specs        SpecIteration[]     @relation("ProjectSpecs")
  runs         WorkflowRun[]
  audits       LlmAuditLog[]
  decisions    DecisionLog[]
  idempotency  IdempotencyRecord[]
  artifacts    SpecArtifact[]
  cards        SpecCard[]
  cardLinks    SpecCardLink[]
}

model SpecIteration {
  id        String            @id @default(cuid())
  projectId String
  version   Int
  data      Json
  createdAt DateTime          @default(now())
  project   ResearchProject   @relation("ProjectSpecs", fields: [projectId], references: [id], onDelete: Cascade)
  latestFor ResearchProject[] @relation("LatestSpec")
  runs      WorkflowRun[]
  artifacts SpecArtifact[]
  cards     SpecCard[]

  @@unique([projectId, version])
  @@index([projectId, version])
}

model WorkflowRun {
  id                String           @id @default(cuid())
  projectId         String
  specIterationId   String
  currentStep       Int              @default(1)
  currentPhase      WorkflowPhase    @default(IDEA)
  completedSteps    Json
  completedPhases   Json             @default("[]")
  artifacts         Json
  latestSpecVersion Int
  status            WorkflowStatus   @default(RUNNING)
  error             String?
  startedAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  project           ResearchProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specIteration     SpecIteration    @relation(fields: [specIterationId], references: [id])
  audits            LlmAuditLog[]
  componentStates   ComponentState[]

  @@index([projectId, status])
}

model ComponentState {
  id            String          @id @default(cuid())
  workflowRunId String
  step          Int
  status        ComponentStatus @default(FRESH)
  output        Json?
  updatedAt     DateTime        @updatedAt
  workflowRun   WorkflowRun     @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([workflowRunId, step])
}

model SpecCard {
  id              String          @id @default(cuid())
  lineageId       String          @default(cuid())
  projectId       String
  specIterationId String
  type            SpecCardType
  status          SpecCardStatus  @default(PROPOSED)
  content         String
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  project         ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specIteration   SpecIteration   @relation(fields: [specIterationId], references: [id], onDelete: Cascade)
  outgoingLinks   SpecCardLink[]  @relation("SourceCard")
  incomingLinks   SpecCardLink[]  @relation("TargetCard")

  @@index([specIterationId, type, status])
  @@index([projectId, specIterationId])
  @@index([projectId, lineageId])
}

model SpecCardLink {
  id              String          @id @default(cuid())
  projectId       String
  specIterationId String
  sourceCardId    String
  targetCardId    String
  type            SpecCardLinkType
  createdAt       DateTime        @default(now())
  project         ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceCard      SpecCard        @relation("SourceCard", fields: [sourceCardId], references: [id], onDelete: Cascade)
  targetCard      SpecCard        @relation("TargetCard", fields: [targetCardId], references: [id], onDelete: Cascade)

  @@unique([sourceCardId, targetCardId, type])
  @@index([specIterationId, type])
}

model LlmAuditLog {
  id              String          @id @default(cuid())
  projectId       String
  workflowRunId   String?
  task            String
  specVersionUsed Int
  inputContext    Json
  inputTokens     Int?
  outputTokens    Int?
  createdAt       DateTime        @default(now())
  project         ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun     WorkflowRun?    @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  @@index([projectId, task, specVersionUsed])
}

model DecisionLog {
  id        String          @id @default(cuid())
  projectId String
  type      DecisionType
  target    String
  value     Json
  createdAt DateTime        @default(now())
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ConfirmationQuestion {
  id         String    @id @default(cuid())
  projectId  String
  question   String
  example    String?
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId, answeredAt])
}

model IdempotencyRecord {
  id        String          @id @default(cuid())
  projectId String
  key       String
  operation String
  result    Json
  createdAt DateTime        @default(now())
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

model SpecArtifact {
  id              String          @id @default(cuid())
  projectId       String
  specIterationId String
  node            String
  status          ArtifactStatus  @default(FRESH)
  data            Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  project         ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specIteration   SpecIteration   @relation(fields: [specIterationId], references: [id], onDelete: Cascade)

  @@unique([specIterationId, node])
  @@index([projectId, node, status])
}
