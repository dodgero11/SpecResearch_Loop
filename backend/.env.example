DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spec_research_loop?schema=public"
PORT=3000
INTERNAL_API_KEY="replace-with-a-long-random-secret"

# Python AI microservice (ai_service). When AI_SERVICE_URL is set, judge tasks run
# through the HTTP adapter against that service; when unset, the in-process local
# mock adapter is used (no AI service required).
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_TIMEOUT_MS=30000
